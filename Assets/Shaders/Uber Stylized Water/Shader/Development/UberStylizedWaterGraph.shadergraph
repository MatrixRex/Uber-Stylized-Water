{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "09098a2d6f75452fb9e1e4ec1f84e82a",
    "m_Group": {
        "m_Id": "1db7afaeec184063b54eeedacf7b2ef4"
    },
    "m_Name": "OklabLerp (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -70.3999252319336,
            "y": 568.7999267578125,
            "width": 214.39990234375,
            "height": 141.60003662109376
        }
    },
    "m_Slots": [
        {
            "m_Id": "7edc38efc7bf408c8901930bf2b35797"
        },
        {
            "m_Id": "63ff9e3e38dc45f485e6a2947bacdd21"
        },
        {
            "m_Id": "cc72bc12f5aa4e2092fb9d26f920f68e"
        },
        {
            "m_Id": "f060b921833c402b91c8e1ff2c6c255d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "OklabLerp",
    "m_FunctionSource": "efbf837ae16a0cc40a3513588f0b6d5e",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// helper to cube a value\r\nfloat3 Cube(float3 v) {\r\n    return v * v * v;\r\n}\r\n\r\n// helper for cube root\r\nfloat3 cbrt_custom(float3 v) {\r\n    return sign(v) * pow(abs(v), 1.0 / 3.0);\r\n}\r\n\r\n// linear rgb -> oklab\r\nfloat3 linear_rgb_to_oklab(float3 c) {\r\n    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;\r\n    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;\r\n    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;\r\n\r\n    float l_ = cbrt_custom(l).x; // ensuring float3 component access\r\n    float m_ = cbrt_custom(m).x;\r\n    float s_ = cbrt_custom(s).x;\r\n    \r\n    // re-packing for vector math\r\n    float3 lms_ = float3(l, m, s);\r\n    lms_ = cbrt_custom(lms_);\r\n\r\n    return float3(\r\n        0.2104542553 * lms_.x + 0.7936177850 * lms_.y - 0.0040720468 * lms_.z,\r\n        1.9779984951 * lms_.x - 2.4285922050 * lms_.y + 0.4505937099 * lms_.z,\r\n        0.0259040371 * lms_.x + 0.7827717662 * lms_.y - 0.8086757660 * lms_.z\r\n    );\r\n}\r\n\r\n// oklab -> linear rgb\r\nfloat3 oklab_to_linear_rgb(float3 c) {\r\n    float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;\r\n    float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;\r\n    float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;\r\n\r\n    float3 lms_ = float3(l_, m_, s_);\r\n    float3 lms = cube(lms_);\r\n\r\n    return float3(\r\n        4.0767416621 * lms.x - 3.3077115913 * lms.y + 0.2309699292 * lms.z,\r\n        -1.2684380046 * lms.x + 2.6097574011 * lms.y - 0.3413193965 * lms.z,\r\n        -0.0041960863 * lms.x - 0.7034186147 * lms.y + 1.7076147010 * lms.z\r\n    );\r\n}\r\n\r\n// main lerp function\r\nvoid OklabLerp_float(float3 ColorA, float3 ColorB, float T, out float3 Out) {\r\n    float3 okA = linear_rgb_to_oklab(ColorA);\r\n    float3 okB = linear_rgb_to_oklab(ColorB);\r\n    \r\n    // lerp in oklab space\r\n    float3 mix = lerp(okA, okB, T);\r\n    \r\n    // convert back to linear rgb\r\n    Out = oklab_to_linear_rgb(mix);\r\n}"
}

