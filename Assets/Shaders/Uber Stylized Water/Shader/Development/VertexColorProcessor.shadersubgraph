    "m_SourceType": 1,
    "m_FunctionName": "ProcessVertexColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float r = VertexColor.r;\nfloat g = VertexColor.g;\nfloat b = VertexColor.b;\nfloat a = VertexColor.a;\n\nfloat isWhite = step(0.999, r * g * b);\nfloat isBlack = 1.0 - step(0.001, r + g + b);\nfloat isUnpainted = max(isWhite, isBlack);\n\nfloat effectiveAlpha = saturate(a + isUnpainted);\nOut = (VertexColor.rgb * (1.0 - isWhite) * (1.0 - isUnpainted)) + (effectiveAlpha * WaterBaseColor);"
}

